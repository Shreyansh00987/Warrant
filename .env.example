# Warrant Environment Configuration

# Clerk Service
PORT=8000
DATABASE_URL=sqlite:///./warrant.db
CLERK_SECRET=change-me-in-production

# GitHub Status Integration (Optional)
# If left empty, Warrant displays "GitHub status not configured" and skips posting.
GITHUB_TOKEN=
GITHUB_REPO=owner/demo-repo

# Approver Authorization
# Comma-separated list of authorized approver IDs or usernames
APPROVER_ALLOWLIST=priya,alec,security-lead

# Optional approver passphrase fallback (used if sender ID cannot be verified)
APPROVER_PASSPHRASE=

# Switch Integration
SWITCH_SERVER_URL=http://localhost:8080
SWITCH_ROOM_ID=warrant-room
SWITCH_AGENT_ID=warrant-clerk

# Web UI
NEXT_PUBLIC_CLERK_API_URL=http://localhost:8000
